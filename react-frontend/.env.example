# Copy this file to ".env.development" (or ".env.local") and adjust the values.
# Everything starting with VITE_ is visible inside the browser bundle.
# NEVER put a secret here. A browser app cannot keep secrets.

# Keycloak server and realm
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=Learn_Microservices

# The PUBLIC Keycloak client of this app (no client secret)
VITE_KEYCLOAK_CLIENT_ID=learn-microservices-web

# Base URL of the API Gateway.
# Leave it empty in development: Vite proxies "/api" to http://localhost:8080.
# In production set it to the public gateway URL (and enable CORS on the gateway).
VITE_API_BASE_URL=
