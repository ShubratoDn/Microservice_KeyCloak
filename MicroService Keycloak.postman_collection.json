{
  "info": {
    "_postman_id": "8f8263c0-ca42-469d-98f6-55b6cfd4b7e5",
    "name": "MicroService Keycloak",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "28095059"
  },
  "item": [
    {
      "name": "customer-service",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Location header is present', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('customerId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rahim\",\n  \"lastName\": \"Uddin\",\n  \"email\": \"rahim.uddin@example.com\",\n  \"phoneNumber\": \"+8801700000000\",\n  \"addresses\": [\n    {\n      \"type\": \"HOME\",\n      \"street\": \"12 Lake Road\",\n      \"city\": \"Dhaka\",\n      \"state\": \"Dhaka\",\n      \"postalCode\": \"1205\",\n      \"country\": \"Bangladesh\"\n    },\n    {\n      \"type\": \"WORK\",\n      \"street\": \"45 Business Avenue\",\n      \"city\": \"Dhaka\",\n      \"postalCode\": \"1212\",\n      \"country\": \"Bangladesh\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": "Creates a new customer. The returned id is saved in the collection variable `customerId`, so the next requests can use it."
          },
          "response": []
        },
        {
          "name": "Create Customer - Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response lists the invalid fields', function () {",
                  "    pm.expect(pm.response.json().errors).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Uddin\",\n  \"email\": \"not-an-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": "Sends a bad request on purpose. Expect 400 with an `errors` object that shows which fields are wrong."
          },
          "response": []
        },
        {
          "name": "Get Customer by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Gets one customer with all its addresses. Returns 404 if the id does not exist."
          },
          "response": []
        },
        {
          "name": "List Customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has page details', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.have.property('content');",
                  "    pm.expect(body).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers?page=0&size=20&sort=id,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page number. It starts from 0."
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "How many customers in one page."
                },
                {
                  "key": "sort",
                  "value": "id,desc",
                  "description": "Sort field and direction (asc or desc)."
                }
              ]
            },
            "description": "Gets customers page by page. This list shows a short summary (no addresses)."
          },
          "response": []
        },
        {
          "name": "Update Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rahim\",\n  \"lastName\": \"Chowdhury\",\n  \"email\": \"rahim.uddin@example.com\",\n  \"phoneNumber\": \"+8801711111111\",\n  \"addresses\": [\n    {\n      \"type\": \"SHIPPING\",\n      \"street\": \"78 River Side\",\n      \"city\": \"Chattogram\",\n      \"state\": \"Chattogram\",\n      \"postalCode\": \"4000\",\n      \"country\": \"Bangladesh\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Replaces the customer details. The address list in the request replaces the old address list."
          },
          "response": []
        },
        {
          "name": "Update Customer Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Status was changed', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('BLOCKED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BLOCKED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}",
                "status"
              ]
            },
            "description": "Changes only the status. Allowed values: ACTIVE, INACTIVE, BLOCKED."
          },
          "response": []
        },
        {
          "name": "Delete Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Deletes the customer and all its addresses."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    }
  ]
}
